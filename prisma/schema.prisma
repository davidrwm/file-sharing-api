
generator client {
  provider = "prisma-client-js"
  output = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String      @id @default(cuid())
  email          String      @unique
  passwordHash   String
  files          StoredFile[]
  sharesReceived FileShare[] @relation("ShareRecipient")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model StoredFile {
  id           String      @id @default(cuid())
  originalName String
  storageKey   String      @unique
  mimeType     String
  sizeBytes    Int
  ownerId      String
  owner        User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  shares       FileShare[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([ownerId])
  @@index([createdAt])
}

model FileShare {
  id          String     @id @default(cuid())
  fileId      String
  recipientId String
  file        StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  recipient   User       @relation("ShareRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@unique([fileId, recipientId])
  @@index([recipientId])
}